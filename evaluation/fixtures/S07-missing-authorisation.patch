--- a/sample-app/tests/test_store.py
+++ b/sample-app/tests/test_store.py
@@ -47,3 +47,11 @@ def test_logs_do_not_contain_email(caplog):
     caplog.set_level("INFO")
     OrderStore().create("ana@example.test", 700)
     assert "ana@example.test" not in caplog.text
+
+
+def test_delete_removes_order():
+    store = OrderStore()
+    order = store.create("ana@example.test", 100)
+    store.delete(order.id, requested_by="ana@example.test")
+    with pytest.raises(KeyError):
+        store.get(order.id)
