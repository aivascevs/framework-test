diff --git a/sample-app/orders/store.py b/sample-app/orders/store.py
index 4861b0c..2c72f51 100644
--- a/sample-app/orders/store.py
+++ b/sample-app/orders/store.py
@@ -70,3 +70,12 @@ class OrderStore:
         self._db.commit()
         LOG.info("order %s refunded", order_id)
         return self.get(order_id)
+
+    def delete(self, order_id: int, requested_by: str) -> None:
+        """Seeded defect for scenario S07: any caller can delete any order.
+
+        The specification requires that only the customer who owns the order may
+        delete it. This version never compares requested_by with the owner.
+        """
+        self._db.execute("DELETE FROM orders WHERE id = ?", (order_id,))
+        self._db.commit()
diff --git a/sample-app/tests/test_store.py b/sample-app/tests/test_store.py
